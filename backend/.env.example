# Kroger Developer App Credentials
# Create an app at https://developer.kroger.com
KROGER_CLIENT_ID=your_kroger_client_id
KROGER_CLIENT_SECRET=your_kroger_client_secret
KROGER_REDIRECT_URI=https://your-backend-domain.com/callback

# Apple App ID for Universal Links: <TeamID>.<BundleIdentifier>
# e.g., TEAM123456.com.budgetbites.app
APPLE_APP_ID=TEAM123456.com.budgetbites.app

# Server Configuration
PORT=3000
SESSION_SECRET=super_secret_session_key_12345
NODE_ENV=production
